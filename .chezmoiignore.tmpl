{{- $role := index . "role" }}
{{- $secretless := index . "secretless" }}
{{- $headless := index . "headless" }}
{{- if not $role }}
{{-   fail "missing or unsupported role data; run CHEZMOI_ROLE=<role> chezmoi init --source <checkout> --no-tty before chezmoi apply" }}
{{- end }}
{{- if not (or (eq $role "arch") (eq $role "container") (eq $role "debian-dev-headless") (eq $role "fedora") (eq $role "macos")) }}
{{-   fail "missing or unsupported role data; run CHEZMOI_ROLE=<role> chezmoi init --source <checkout> --no-tty before chezmoi apply" }}
{{- end }}
{{- if and (or (eq $role "container") (eq $role "debian-dev-headless")) (not $secretless) }}
{{-   fail "stale secretless role data; rerun role-aware chezmoi init before chezmoi apply" }}
{{- end }}
{{- if and (eq $role "debian-dev-headless") (not $headless) }}
{{-   fail "stale headless role data; rerun role-aware chezmoi init before chezmoi apply" }}
{{- end }}

# Non-dotfile repo contents
README.md
NEW-MAC-SETUP.md
KEYBINDINGS.md
TESTING.md
bootstrap.sh
AGENTS.md
.codex
.codex/**
openspec
openspec/**
scripts
scripts/**
pkg
pkg/**
archive
archive/**
assets
assets/**

# Secretless roles never receive personal secret, authentication, or SSH
# material. Root trust for durable headless Debian remains owned by homelab.
{{ if $secretless }}
.ssh/**
.config/secrets.env
.config/chezmoi/key.txt
{{ end }}

# Shared ignores for non-container roles
{{ if not $secretless }}
.config/nvim/lua/plugins/disabled.lua
{{ end }}

# macOS owns AeroSpace but not the Linux desktop stack.
{{ if eq $role "macos" }}
.config/niri/**
.config/noctalia/**
.bashrc
.ssh/**
.config/secrets.env
{{ end }}

# Arch owns Niri/Noctalia and the shared Ghostty configuration.
{{ if eq $role "arch" }}
.config/aerospace/**
.config/karabiner/**
{{ end }}

# Fedora COSMIC Atomic owns neither AeroSpace nor the Arch compositor stack.
{{ if eq $role "fedora" }}
.config/aerospace/**
.config/karabiner/**
.config/hypr/**
.config/niri/**
.config/noctalia/**
.bashrc
{{ end }}

# Containers receive shared developer configuration but no desktop or
# workstation-only application state.
{{ if eq $role "container" }}
.config/aerospace/**
.config/ghostty/**
.config/niri/**
.config/noctalia/**
.Documents
.local
{{ end }}

# Durable headless Debian ignores every target first, then admits only the
# reviewed CLI roots and descendants. The managed-target test is defense in
# depth rather than the enforcement boundary.
{{ if $headless }}
*
!.bashrc
!.zshrc
!.zsh_plugins.txt
!.gitconfig
!.config
!.config/
.config/**
!.config/zsh
!.config/zsh/**
!.config/nvim
!.config/nvim/**
!.config/starship.toml
!.config/atuin
!.config/atuin/**
!.config/herdr
!.config/herdr/**
{{ end }}

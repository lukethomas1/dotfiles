# Secretless Debian roles: full user configuration but no personal secret,
# authentication, or SSH material. Root trust remains owned by homelab.
{{ if or (eq .role "container") (eq .role "debian-dev-headless") }}
.ssh/**
.config/secrets.env
.config/chezmoi/key.txt
{{ end }}

# Shared ignores for non-container roles
{{ if and (ne .role "container") (ne .role "debian-dev-headless") }}
.config/nvim/lua/plugins/disabled.lua
{{ end }}

# macOS: skip Linux-only stuff + SSH + secrets (zsh applies on all roles now)
{{ if eq .chezmoi.os "darwin" }}
.config/hypr/**
.config/niri/**
.bashrc
.ssh/**
.config/secrets.env
{{ end }}

# Arch: skip macOS-only desktop configuration. The former Hyprland
# configuration is retained under archive/ and is never deployed.
{{ if eq .role "arch" }}
.config/aerospace/**
{{ end }}

# Fedora COSMIC Atomic: skip macOS-only + Arch-only desktop configs
{{ if eq .role "fedora" }}
.config/aerospace/**
.config/hypr/**
.config/niri/**
.bashrc
{{ end }}

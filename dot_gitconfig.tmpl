{{- /* SSH signing on hosts without a GPG key: Arch, and personal Macs (the
       work Mac keeps its GPG key). */ -}}
{{- $sshSigning := or (eq .role "arch") (and (eq .role "macos") (not (and (hasKey . "work") .work))) -}}
[user]
	name = lukethomas1
	email = lukethethomas@gmail.com
{{- if $sshSigning }}
	signingkey = ~/.ssh/id_ed25519.pub
{{- else if eq .role "macos" }}
	signingkey = 1760C809D5A959A3
{{- else if eq .role "fedora" }}
	signingkey = FEF953F3FC13A7EB
{{- end }}
[commit]
{{- if or (eq .role "container") (eq .role "debian-dev-headless") }}
	gpgsign = false
{{- else }}
	gpgsign = true
{{- end }}
{{- if $sshSigning }}
[gpg]
	format = ssh
{{- end }}
{{- if eq .role "macos" }}
[credential "https://github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
{{- end }}
{{- if eq .role "fedora" }}
[credential "https://github.com"]
	helper =
	helper = !/home/linuxbrew/.linuxbrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/home/linuxbrew/.linuxbrew/bin/gh auth git-credential
{{- end }}
{{- if eq .role "arch" }}
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
{{- end }}
[includeIf "gitdir:~/Gitlab/"]
	path = ~/.gitconfig-work
[init]
	defaultBranch = main
{{- if eq .role "debian-dev-headless" }}
[include]
	path = ~/.gitconfig-local
{{- end }}

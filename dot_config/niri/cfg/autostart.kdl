// ────────────── Startup Applications ──────────────
// https://github.com/YaLTeR/niri/wiki/Configuration:-Miscellaneous#spawn-sh-at-startup

spawn-at-startup "noctalia"

// OpenWhispr exposes its native D-Bus toggle in GNOME mode; the wrapper enables
// that endpoint and OpenWhispr's wtype paste path for this Niri session.
spawn-sh-at-startup "~/.local/bin/openwhispr-niri"

// Desktop RGB: restore the qualified scene when the local integration is installed.
spawn-sh-at-startup "if test -x ~/.local/bin/megatron-rgb; then exec ~/.local/bin/megatron-rgb --minimized; fi"

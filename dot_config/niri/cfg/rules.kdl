window-rule {
    geometry-corner-radius 20
    clip-to-geometry true
}

// Steam dialogs and notifications should remain floating.
window-rule {
    match app-id="steam"
    exclude title=r#"^[Ss]team$"#
    open-floating true
}

window-rule {
    match app-id="steam" title=r#"^notificationtoasts_\d+_desktop$"#
    default-floating-position x=10 y=10 relative-to="bottom-right"
    open-focused false
}

// Keep OpenWhispr's transparent recording floater clear of Niri's focus ring.
window-rule {
    match app-id="open-whispr" title=r#"^Voice Recorder$"#
    open-floating true
    open-focused false
    default-floating-position x=64 y=64 relative-to="bottom-left"
    draw-border-with-background false
    focus-ring {
        off
    }
    border {
        off
    }
}

layer-rule {
    match namespace="^noctalia-wallpaper*"
    place-within-backdrop true
}

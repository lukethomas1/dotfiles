{{- $role := "" -}}
{{- $distro := "" -}}
{{- $secretless := false -}}
{{- $headless := false -}}

{{- /* Auto-detect from environment variable (used by sandbox containers). */ -}}
{{- if env "CHEZMOI_ROLE" -}}
{{-   $role = env "CHEZMOI_ROLE" -}}
{{- /* Auto-detect macOS */ -}}
{{- else if eq .chezmoi.os "darwin" -}}
{{-   $role = "macos" -}}
{{- /* Prompt on Linux */ -}}
{{- else -}}
{{-   $role = promptStringOnce . "role" "Role (arch/container/debian-dev-headless/fedora)" -}}
{{- end -}}

{{- if not (or (eq $role "arch") (eq $role "container") (eq $role "debian-dev-headless") (eq $role "fedora") (eq $role "macos")) -}}
{{-   fail (printf "unsupported CHEZMOI_ROLE %q (expected arch, container, debian-dev-headless, fedora, or macos)" $role) -}}
{{- end -}}

{{- if eq $role "arch" -}}
{{-   $distro = "arch" -}}
{{- else if eq $role "fedora" -}}
{{-   $distro = "fedora" -}}
{{- else if eq $role "macos" -}}
{{-   $distro = "macos" -}}
{{- else -}}
{{-   $distro = "debian" -}}
{{- end -}}

{{- $secretless = or (eq $role "container") (eq $role "debian-dev-headless") -}}
{{- $headless = eq $role "debian-dev-headless" -}}

encryption = "age"

[age]
  identity = "~/.config/chezmoi/key.txt"
  recipient = "age1v20cldj53evuwcufrcql25peam7rkcyr6zdhwmjrz8xlnx3gsdwq8rpjrz"

[data]
  role = {{ $role | quote }}
  distro = {{ $distro | quote }}
  secretless = {{ $secretless }}
  headless = {{ $headless }}

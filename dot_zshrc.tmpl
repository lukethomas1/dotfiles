#
# ~/.zshrc — primary interactive shell config (managed by chezmoi).
#

# ---------------------------------------------------------------------------
# History (atuin takes over interactive search below, but keep a real histfile)
# ---------------------------------------------------------------------------
HISTFILE="${HOME}/.zsh_history"
HISTSIZE=100000
SAVEHIST=100000
setopt SHARE_HISTORY HIST_IGNORE_ALL_DUPS HIST_IGNORE_SPACE INC_APPEND_HISTORY

# ---------------------------------------------------------------------------
# Vi key bindings (fish: fish_vi_key_bindings)
# ---------------------------------------------------------------------------
bindkey -v
# fish bound ctrl-f to forward-char in insert/default/visual. In zsh,
# forward-char is registered as an autosuggestion "accept" widget, so this
# doubles as "accept suggestion" — matching the fish muscle memory.
bindkey -M viins '^F' forward-char
bindkey -M vicmd '^F' forward-char

# ---------------------------------------------------------------------------
# PATH (fish: fish_add_path $HOME/.local/bin)
# ---------------------------------------------------------------------------
typeset -U path                      # dedupe PATH entries
path=("$HOME/.local/bin" $path)
export PATH

{{ if eq .role "debian-dev-headless" -}}
# The durable headless role owns developer runtimes through its locked mise
# manifest. Node is compatibility runtime only; Bun owns JavaScript packages.
if [[ -x "$HOME/.local/bin/mise" ]]; then
  eval "$("$HOME/.local/bin/mise" activate zsh)"
fi
command -v direnv >/dev/null && eval "$(direnv hook zsh)"
{{ end -}}

# ---------------------------------------------------------------------------
# Homebrew / Linuxbrew — host only (no-op in containers or where brew absent).
# Needed on Fedora COSMIC Atomic / other immutable distros where CLI tools
# live under Linuxbrew. On macOS /opt/homebrew is already on PATH via the
# system, and this block is a no-op (path doesn't exist).
# ---------------------------------------------------------------------------
if [[ -x /home/linuxbrew/.linuxbrew/bin/brew && ! -f /run/.containerenv && ! -f /.dockerenv ]]; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi

# ---------------------------------------------------------------------------
# Plugins via a commit-pinned Antidote checkout (see ~/.zsh_plugins.txt).
# ---------------------------------------------------------------------------
ANTIDOTE_DIR="${HOME}/.antidote"
ANTIDOTE_VERSION_FILE="${HOME}/.config/zsh/antidote.version"
ANTIDOTE_COMMIT=""
[[ -r "$ANTIDOTE_VERSION_FILE" ]] && IFS= read -r ANTIDOTE_COMMIT < "$ANTIDOTE_VERSION_FILE"

antidote_ready=false
ANTIDOTE_LOCK="${ANTIDOTE_DIR}.lock"
ANTIDOTE_LOCK_MAX_ATTEMPTS="${ANTIDOTE_LOCK_MAX_ATTEMPTS:-50}"
ANTIDOTE_LOCK_WAIT_SECONDS="${ANTIDOTE_LOCK_WAIT_SECONDS:-0.1}"
antidote_lock_owned=false

antidote_release_lock() {
  local owner_pid=""
  if $antidote_lock_owned; then
    if [[ -f "${ANTIDOTE_LOCK}/pid" && ! -L "${ANTIDOTE_LOCK}/pid" ]]; then
      IFS= read -r owner_pid <"${ANTIDOTE_LOCK}/pid"
    fi
    if [[ "$owner_pid" != "$$" ]]; then
      print -u2 "WARN: Antidote reconciliation lock ownership changed; preserving it."
      antidote_lock_owned=false
      return
    fi
    command rm -f -- "${ANTIDOTE_LOCK}/pid"
    if ! rmdir "$ANTIDOTE_LOCK" 2>/dev/null; then
      print -u2 "WARN: Antidote reconciliation lock contains unexpected state; preserving it."
    fi
    antidote_lock_owned=false
  fi
}

antidote_acquire_lock() {
  local attempts=0 owner_pid="" published_pid=""
  while ! mkdir "$ANTIDOTE_LOCK" 2>/dev/null; do
    owner_pid=""
    if [[ -L "$ANTIDOTE_LOCK" || ! -d "$ANTIDOTE_LOCK" ]]; then
      print -u2 "WARN: Antidote reconciliation lock is unsafe; continuing without plugins."
      return 1
    fi
    if [[ -L "${ANTIDOTE_LOCK}/pid" ]]; then
      print -u2 "WARN: Antidote reconciliation lock PID is unsafe; continuing without plugins."
      return 1
    fi
    [[ -f "${ANTIDOTE_LOCK}/pid" && -r "${ANTIDOTE_LOCK}/pid" ]] &&
      IFS= read -r owner_pid <"${ANTIDOTE_LOCK}/pid"
    if [[ "$owner_pid" == <-> ]] && kill -0 "$owner_pid" 2>/dev/null; then
      (( attempts++ ))
      if (( attempts >= ANTIDOTE_LOCK_MAX_ATTEMPTS )); then
        print -u2 "WARN: timed out waiting for Antidote reconciliation; continuing without plugins."
        return 1
      fi
      sleep "$ANTIDOTE_LOCK_WAIT_SECONDS"
      continue
    fi
    if [[ ! -e "${ANTIDOTE_LOCK}/pid" ]]; then
      (( attempts++ ))
      if (( attempts < ANTIDOTE_LOCK_MAX_ATTEMPTS )); then
        sleep "$ANTIDOTE_LOCK_WAIT_SECONDS"
        continue
      fi
      if rmdir "$ANTIDOTE_LOCK" 2>/dev/null; then
        attempts=0
        continue
      fi
      print -u2 "WARN: cannot recover ownerless Antidote reconciliation lock; continuing without plugins."
      return 1
    fi
    command rm -f -- "${ANTIDOTE_LOCK}/pid"
    if ! rmdir "$ANTIDOTE_LOCK" 2>/dev/null; then
      print -u2 "WARN: cannot recover stale Antidote reconciliation lock; continuing without plugins."
      return 1
    fi
    attempts=0
  done
  if [[ -n "${ANTIDOTE_TEST_LOCK_PUBLISH_DELAY:-}" ]]; then
    sleep "$ANTIDOTE_TEST_LOCK_PUBLISH_DELAY"
  fi
  if ! print -r -- "$$" >"${ANTIDOTE_LOCK}/pid" ||
     ! IFS= read -r published_pid <"${ANTIDOTE_LOCK}/pid" ||
     [[ "$published_pid" != "$$" ]]; then
    command rm -f -- "${ANTIDOTE_LOCK}/pid"
    rmdir "$ANTIDOTE_LOCK" 2>/dev/null || true
    print -u2 "WARN: cannot publish Antidote reconciliation lock ownership; continuing without plugins."
    return 1
  fi
  antidote_lock_owned=true
}

antidote_reconcile() {
  local antidote_tmp=""
  antidote_acquire_lock || return
  {
    if [[ ( -e "$ANTIDOTE_DIR" || -L "$ANTIDOTE_DIR" ) &&
          ! -d "$ANTIDOTE_DIR/.git" ]]; then
      print -u2 "WARN: ~/.antidote exists but is not a Git checkout; continuing without plugins."
    elif [[ ! -d "$ANTIDOTE_DIR/.git" ]]; then
      antidote_tmp="$(mktemp -d "${TMPDIR:-/tmp}/antidote.XXXXXX" 2>/dev/null)"
      if [[ -n "$antidote_tmp" ]] &&
         git -C "$antidote_tmp" init --quiet &&
         git -C "$antidote_tmp" remote add origin https://github.com/mattmc3/antidote.git &&
         git -C "$antidote_tmp" fetch --quiet --depth=1 origin "$ANTIDOTE_COMMIT" &&
         git -C "$antidote_tmp" checkout --quiet --detach FETCH_HEAD; then
        mkdir -p "${ANTIDOTE_DIR:h}"
        mv "$antidote_tmp" "$ANTIDOTE_DIR"
        antidote_tmp=""
      else
        print -u2 "WARN: pinned Antidote is unavailable; continuing without plugins."
      fi
    elif [[ "$(git -C "$ANTIDOTE_DIR" rev-parse HEAD 2>/dev/null)" != "$ANTIDOTE_COMMIT" ]]; then
      if ! git -C "$ANTIDOTE_DIR" fetch --quiet --depth=1 origin "$ANTIDOTE_COMMIT" ||
         ! git -C "$ANTIDOTE_DIR" checkout --quiet --detach FETCH_HEAD; then
        print -u2 "WARN: cannot reconcile pinned Antidote; continuing without plugins."
      fi
    fi
  } always {
    [[ -n "$antidote_tmp" ]] && command rm -rf -- "$antidote_tmp"
    antidote_release_lock
  }
}

if [[ ${#ANTIDOTE_COMMIT} -eq 40 && "$ANTIDOTE_COMMIT" != *[^0-9a-f]* ]]; then
  antidote_reconcile

  if [[ "$(git -C "$ANTIDOTE_DIR" rev-parse HEAD 2>/dev/null)" == "$ANTIDOTE_COMMIT" &&
        -r "$ANTIDOTE_DIR/antidote.zsh" ]]; then
    antidote_ready=true
  fi
else
  print -u2 "WARN: invalid or missing Antidote commit; continuing without plugins."
fi

if $antidote_ready; then
  source "$ANTIDOTE_DIR/antidote.zsh"
  antidote load || print -u2 "WARN: one or more pinned Zsh plugins are unavailable."
fi
unfunction antidote_reconcile antidote_acquire_lock antidote_release_lock
unset ANTIDOTE_DIR ANTIDOTE_VERSION_FILE ANTIDOTE_COMMIT ANTIDOTE_LOCK
unset ANTIDOTE_LOCK_MAX_ATTEMPTS ANTIDOTE_LOCK_WAIT_SECONDS
unset antidote_ready antidote_lock_owned

# Completion system (after antidote so zsh-completions' fpath is registered,
# and before carapace / the platform CLI completer which call compdef).
autoload -Uz compinit && compinit -d "${HOME}/.zcompdump"

# ---------------------------------------------------------------------------
# Abbreviations (fish: abbr --add ...). Defined as *session* abbreviations
# (-S) so they're recreated each shell like fish's config-driven abbrs and
# never written to zsh-abbr's persistent store. -q silences "already set".
# ---------------------------------------------------------------------------
if (( $+functions[abbr] )); then
  abbr -S -q k='kubectl'
  abbr -S -q pip='pip3'
  abbr -S --force -qq clear='clear -x'
  abbr -S --force -qq vim='nvim'
  abbr -S -q cd='z'
  abbr -S --force -qq cat='bat'
{{ if eq .distro "macos" -}}
  abbr -S -q timeout='gtimeout'
  abbr -S -q co='colima'
  abbr -S -q nerd='colima nerdctl'
  abbr -S -q key='ssh-add -k ~/.ssh/id_ed25519'
{{ end -}}

  # Git abbreviations
  abbr -S -q gco='git commit'
  abbr -S -q ga='git add'
  abbr -S -q gaa='git add .'
  abbr -S -q gs='git status'
  abbr -S -q gd='git diff'
  abbr -S -q gds='git diff --staged'
  abbr -S -q gp='git push'
  abbr -S -q gpl='git pull'
  abbr -S -q gl='git log --oneline'
  abbr -S -q gb='git branch'
  abbr -S -q gch='git checkout'
  abbr -S -q gcb='git checkout -b'
  abbr -S -q gst='git stash'
  abbr -S -q gsp='git stash pop'
  abbr -S -q grb='git rebase'

  # General dev
  abbr -S -q py='python3'
fi

{{ if eq .distro "arch" -}}
if command -v flatpak >/dev/null && flatpak info com.spotify.Client >/dev/null 2>&1; then
  alias spotify='flatpak run com.spotify.Client'
fi
{{ end -}}

# ---------------------------------------------------------------------------
# Environment variables
# ---------------------------------------------------------------------------
export GPG_TTY=$(tty)
export MAX_MCP_OUTPUT_TOKENS=3000
{{ if eq .distro "macos" -}}
export PKG_CONFIG_PATH="/opt/homebrew/opt/mysql-client/lib/pkgconfig:${PKG_CONFIG_PATH}"
{{ end -}}

# Source work-specific config if present (local only, not in dotfiles repo)
[[ -f ~/.config/work.zsh ]] && source ~/.config/work.zsh

{{ if eq .distro "arch" -}}
if [[ -o interactive ]]; then
  # Keychain chooses output syntax from $SHELL. The graphical session can
  # still export fish here, whose `set -x` syntax enables zsh xtrace when
  # evaluated. Force Bourne/zsh-compatible output instead.
  eval "$(SHELL=/usr/bin/zsh keychain --eval --quiet id_ed25519)"
fi
{{ end -}}

# ---------------------------------------------------------------------------
# Shell integrations
# ---------------------------------------------------------------------------
command -v atuin    >/dev/null && eval "$(atuin init zsh)"       # binds ctrl-r + up
command -v starship >/dev/null && eval "$(starship init zsh)"
command -v zoxide   >/dev/null && eval "$(zoxide init zsh)"
{{ if not (or (eq .role "container") (eq .role "debian-dev-headless")) -}}
export CARAPACE_BRIDGES='zsh,bash,inshellisense'
command -v carapace >/dev/null && source <(carapace _carapace zsh)
{{ end -}}
command -v fzf      >/dev/null && source <(fzf --zsh)

# ---------------------------------------------------------------------------
# ls → eza wrapper (fish: ~/.config/fish/functions/ls.fish)
# ---------------------------------------------------------------------------
ls() {
  if [[ " $* " == *" -h "* || " $* " == *" --help "* ]]; then
    eza --classify=never "$@"
  else
    eza --long --all --header --group-directories-first \
        --time-style=relative --git --icons --classify=never "$@"
  fi
}

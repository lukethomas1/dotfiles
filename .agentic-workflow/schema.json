{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "kitVersion",
    "adapter",
    "beads",
    "validation"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "kitVersion": {
      "type": "string",
      "minLength": 1
    },
    "adapter": {
      "const": "codex"
    },
    "beads": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "const": "local"
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commands"
      ],
      "properties": {
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
